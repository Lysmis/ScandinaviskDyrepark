<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Content/UI/UiStyleSheets/LevelSelection_USS.uss?fileID=7433441132597879392&amp;guid=0a15b1733e8483f418481ccee4d549aa&amp;type=3#LevelSelection_USS" />
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; align-items: center; align-content: center; display: flex; background-image: url(&quot;project://database/Assets/Content/Sprites/GUI/Baggrund_r%C3%A6v.png?fileID=2800000&amp;guid=828e7dfe3d103b94aa54fa7b919b7317&amp;type=3#Baggrund_ræv&quot;);">
        <ui:Label text="Vælg et dyr" name="LevelSelectLabel" parse-escape-sequences="true" style="font-size: 60px; -unity-text-align: middle-center; -unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Assets/Content/Fonts/FilsonProBlack.otf?fileID=12800000&amp;guid=cf8741c05ef070449b7c5a849e8b6043&amp;type=3#FilsonProBlack&quot;); -unity-text-outline-color: rgb(58, 68, 40); -unity-text-outline-width: 0.5px; color: rgb(239, 225, 196); height: 10%;" />
        <ui:VisualElement name="ButtonContainer" class="buttoncontainer">
            <ui:Button text="Rensdyr" name="DeerLevelButton" icon-image="project://database/Assets/Content/Images/Animal-Reindeer.png?fileID=2800000&amp;guid=b37d4328b77fca549910370476623b94&amp;type=3#Animal-Reindeer" selectable="false" focusable="false" emoji-fallback-support="false" class="button-chooseanimal" style="-unity-font-definition: url(&quot;project://database/Assets/Content/Fonts/FilsonProBook.otf?fileID=12800000&amp;guid=7b0426bf1330f3746962c61017c030fc&amp;type=3#FilsonProBook&quot;); background-image: url(&quot;project://database/Assets/Content/Sprites/GUI/Frame%20E-1.png.png?fileID=2800000&amp;guid=8a5863ed6d74d5d4b92a9853741b941b&amp;type=3#Frame E-1.png&quot;);" />
            <ui:Button text="Rød ræv" name="FoxLevelButton" icon-image="project://database/Assets/Content/Images/Animal-Fox.png?fileID=2800000&amp;guid=3c9935c61fa5f0f419f3acb91c4ba111&amp;type=3#Animal-Fox" focusable="false" selectable="false" emoji-fallback-support="true" class="button-chooseanimal newstyle" style="-unity-font-definition: url(&quot;project://database/Assets/Content/Fonts/FilsonProBook.otf?fileID=12800000&amp;guid=7b0426bf1330f3746962c61017c030fc&amp;type=3#FilsonProBook&quot;);" />
            <ui:Button text="Havørn" name="EagleLevelButton" icon-image="project://database/Assets/Content/Images/Animal-Eagle.png?fileID=2800000&amp;guid=4b616434a819d3741b9ac2834ab561a5&amp;type=3#Animal-Eagle" selectable="false" focusable="false" emoji-fallback-support="true" class="button-chooseanimal" style="-unity-font-definition: url(&quot;project://database/Assets/Content/Fonts/FilsonProBook.otf?fileID=12800000&amp;guid=7b0426bf1330f3746962c61017c030fc&amp;type=3#FilsonProBook&quot;);" />
            <ui:Button text="Ilder" name="FerretLevelButton" class="button-chooseanimal" style="display: none;" />
            <ui:Button text="Isbjørn" name="PolarBearLevelButton" class="button-chooseanimal" style="display: none;" />
            <ui:Button text="Ulv" name="WolfLevelButton" icon-image="project://database/Assets/Content/Images/Animal-Wolf.png?fileID=2800000&amp;guid=812054917fb9bd94a918f51c528822ea&amp;type=3#Animal-Wolf" class="button-chooseanimal" style="display: flex; -unity-font-definition: url(&quot;project://database/Assets/Content/Fonts/FilsonProBook.otf?fileID=12800000&amp;guid=7b0426bf1330f3746962c61017c030fc&amp;type=3#FilsonProBook&quot;);" />
            <ui:Button text="Brun bjørn" name="BearLevelButton" enabled="true" selectable="true" class="button-chooseanimal" style="display: none;" />
        </ui:VisualElement>
        <ui:TextField placeholder-text="Kodeord til nye baner" name="PasswordTextInput" auto-correction="true" enabled="true" hide-placeholder-on-focus="false" style="align-self: center; background-color: rgba(155, 155, 155, 0); top: auto; width: 60%; -unity-background-image-tint-color: rgba(255, 255, 255, 0); background-size: 340px 100px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; -unity-background-scale-mode: scale-and-crop; border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-left-color: rgb(58, 68, 40); border-right-color: rgb(58, 68, 40); border-top-color: rgb(58, 68, 40); border-bottom-color: rgb(58, 68, 40); font-size: 26px; -unity-text-align: middle-center; flex-direction: row; align-items: center; justify-content: center; height: auto; -unity-font-definition: url(&quot;project://database/Assets/Content/Fonts/FilsonProBook.otf?fileID=12800000&amp;guid=7b0426bf1330f3746962c61017c030fc&amp;type=3#FilsonProBook&quot;);" />
    </ui:VisualElement>
</ui:UXML>
