.button-chooseanimal {
    -unity-background-scale-mode: scale-to-fit;
    background-position-x: left 0;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    font-size: 20px;
    color: rgb(255, 250, 250);
    width: 25%;
    height: 45%;
    border-color: rgb(58, 68, 40);
    background-color: rgb(206, 211, 156);
    padding-right: 10px;
    padding-left: 10px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    margin-right: 2.5%;
    margin-left: 2.5%;
    margin-top: 2.5%;
    margin-bottom: 2.5%;
    flex-direction: column-reverse;
    font-size: 26px;
    color: rgb(58, 68, 40);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-align: lower-center;
}

.buttoncontainer {
    flex-direction: row;
    align-items: center;
    align-content: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    align-self: center;
    flex-wrap: wrap;
    height: 60%;
    padding-right: 15%;
    padding-left: 15%;
}

#DeerLevelButton:hover {
    scale: 1.1 1.1 1.1;
}

#DeerLevelButton:active {
    scale: 0.9 0.9 0.9;
}

#FoxLevelButton:hover {
    scale: 1.1 1.1 1.1;
}

#FoxLevelButton:active {
    scale: 0.9 0.9 0.9;
}

#EagleLevelButton:hover {
    scale: 1.1 1.1 1.1;
}

#EagleLevelButton:active {
    scale: 0.9 0.9 0.9;
}

#WolfLevelButton:hover {
    scale: 1.1 1.1 1.1;
}

#WolfLevelButton:active {
    scale: 0.9 0.9 0.9;
}
