VisualElement {
}

.flag:hover {
    scale: 1.2 1.2 1.2;
    transition-property: all;
    transition-duration: 0.15s;
    transition-timing-function: ease;
    transition-delay: 0s;
}

.flag:active {
    scale: 0.9 0.9 0.9;
}

#StartButton:hover {
    scale: 1.1 1.1 1.1;
}

#StartButton:active {
    scale: 0.9 0.9 0.9;
}
